{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": false,
    "jsx": "react-native",
    "strict": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@components/*": ["src/Components/*"],
      "@screens/*": ["src/Screens/*"],
      "@utils/*": ["src/utils/*"]
    }
  },
  "include": ["src", "index.js"],
  "exclude": ["node_modules", "dist", ".expo"]
}
