# ==================================================
# ~/.zshrc
# ==================================================
# Orden de carga:
#   1. Powerlevel10k Instant Prompt (siempre primero)
#   2. Entorno: PATH, Homebrew, SDKs
#   3. Oh My Zsh
#   4. Widgets, aliases, herramientas y funciones
#   5. Config de p10k (al final)

# ==================================================
# 1. Powerlevel10k Instant Prompt
# ==================================================
# Todo lo que pida input por consola debe ir ANTES de este bloque.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Evita quedar en el filesystem de Windows al abrir WSL (opcional)
# if [[ "$PWD" == /mnt/c/* ]]; then
#     cd "$HOME"
# fi

# ==================================================
# 2. Entorno
# ==================================================
# Elimina duplicados de PATH y FPATH automáticamente
typeset -U path fpath

# Homebrew: debe cargarse ANTES de Oh My Zsh para que sus completions
# entren al fpath antes de compinit, y para que `command -v eza/bat/...`
# encuentre los binarios instalados con brew.
if [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv zsh)"
fi

# Rutas base (DRY: un solo lugar para el home de Windows)
WIN_HOME="/mnt/c/Users/blasi"

# PATH propio
[[ -d "$HOME/.local/bin" ]] && path=("$HOME/.local/bin" $path)

# fnm
FNM_PATH="$HOME/.local/share/fnm"
[[ -d "$FNM_PATH" ]] && path=("$FNM_PATH" $path)

# pnpm (PNPM_HOME ya es el directorio de binarios, no lleva /bin)
export PNPM_HOME="$HOME/.local/share/pnpm"
[[ -d "$PNPM_HOME" ]] && path=("$PNPM_HOME" $path)

# Android SDK (instalado en Windows)
export ANDROID_HOME="$WIN_HOME/AppData/Local/Android/Sdk"
export ANDROID_SDK_ROOT="$ANDROID_HOME"   # deprecado, pero algunas herramientas aún lo leen
if [[ -d "$ANDROID_HOME" ]]; then
    path=("$ANDROID_HOME/platform-tools" "$ANDROID_HOME/emulator" $path)
fi

# ==================================================
# 3. Oh My Zsh
# ==================================================
export ZSH="$HOME/.oh-my-zsh"

ZSH_THEME="powerlevel10k/powerlevel10k"

# 'auto' actualiza sin preguntar, así no imprime avisos que rompan el prompt
zstyle ':omz:update' mode auto

plugins=(
    git
    sudo
    docker
    zsh-autosuggestions
    zsh-syntax-highlighting   # debe ir al final de la lista
)

source "$ZSH/oh-my-zsh.sh"

# ==================================================
# 4. Atajo: ->VARIABLE/SUBCARPETAS  =>  cd "$VARIABLE/SUBCARPETAS"
# ==================================================
# Prefijos aceptados: ->  =>  >  -
# Ejemplos: ->REPO   >REPO/Desarrollo-movil   -WRP
function cd-variable-accept() {
    emulate -L zsh
    local re='^(->|=>|>|-)([A-Za-z_][A-Za-z0-9_]*)(/(.*))?$'
    local var subpath target

    if [[ "$BUFFER" =~ $re ]]; then
        var="${match[2]}"
        subpath="${match[4]}"
        target="${(P)var}"

        if [[ -z "$target" ]]; then
            zle -M "La variable '$var' no existe o está vacía"
            return 0
        fi

        [[ -n "$subpath" ]] && target="${target%/}/${subpath}"

        if [[ -d "$target" ]]; then
            BUFFER="cd -- ${(q)target}"
            CURSOR=${#BUFFER}
            zle accept-line
            return 0
        fi

        zle -M "La carpeta '$target' no existe"
        return 0
    fi

    # Comportamiento normal de Enter
    zle accept-line
}
zle -N cd-variable-accept

# Enter
bindkey '^M' cd-variable-accept
bindkey '^J' cd-variable-accept

# ==================================================
# 5. Variables de rutas frecuentes
# ==================================================
REPO="$WIN_HOME/Ian/UPQ/4to-cuatri/Repos"
DAMR="$REPO/Desarrollo-movil"
DAWR="$WIN_HOME/Ian/Installs/xampp_v1/htdocs/Repositorios/DAW-ITIID-223--DavoBlas"

WRP="$HOME/Dev/UPQ/Repos"
DAP="$WRP/Desarrollo-movil/Apps-Moviles"
PSS="$HOME/Projects/Proyecto-SS"   # antes 'ƒ': un carácter no válido como nombre de variable

# ==================================================
# 6. Aliases
# ==================================================
# eza / bat
if (( $+commands[eza] )); then
    alias ls='eza'
    alias ll='eza -lah'
    alias lt='eza --tree'
    alias ltg='eza --tree --git-ignore'
fi

if (( $+commands[bat] )); then
    alias cat='bat --paging=never'
elif (( $+commands[batcat] )); then      # nombre del binario en Debian/Ubuntu
    alias bat='batcat'
    alias cat='batcat --paging=never'
fi

# Generales (OMZ ya define '..', '...', ga, gc y gp, por eso no se repiten)
alias cls='clear'

# Git (gl sobrescribe 'git pull' del plugin git de OMZ)
alias gs='git status'
alias gl='git log --oneline --graph --decorate'

# Herramientas (solo si existen)
(( $+commands[nvim] ))    && alias v='nvim'
(( $+commands[docker] ))  && { alias d='docker'; alias dc='docker compose' }
(( $+commands[kubectl] )) && alias k='kubectl'
(( $+commands[lazygit] )) && alias lg='lazygit'

# Programas de Windows (WSL)
[[ -x "$WIN_HOME/AppData/Roaming/Spotify/spotify.exe" ]] \
    && alias spotify="$WIN_HOME/AppData/Roaming/Spotify/spotify.exe"
[[ -x "$WIN_HOME/Ian/Installs/Obsidian/Obsidian.exe" ]] \
    && alias obs="$WIN_HOME/Ian/Installs/Obsidian/Obsidian.exe"
(( $+commands[win32yank.exe] )) && alias win32yank='win32yank.exe'

# ==================================================
# 7. Herramientas modernas
# ==================================================
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"

# `fzf --zsh` requiere fzf >= 0.48
if (( $+commands[fzf] )); then
    source <(fzf --zsh)
fi

# Node: fnm (con autocompletado)
if (( $+commands[fnm] )); then
    eval "$(fnm env --use-on-cd --shell zsh)"
    eval "$(fnm completions --shell zsh)"
fi

# ==================================================
# 8. ADB (usa adb.exe de Windows con rutas convertidas)
# ==================================================
# Convierte rutas locales a formato Windows, salvo después de
# `shell`/`exec-out`, donde los argumentos son del dispositivo.
if (( $+commands[adb.exe] )); then
    function _adb_win() {
        emulate -L zsh
        local -a args=()
        local arg
        local convert=1

        for arg in "$@"; do
            case "$arg" in
                shell|exec-out|exec-in) convert=0 ;;
                *) (( convert )) && [[ -e "$arg" ]] && arg="$(wslpath -w "${arg:A}")" ;;
            esac
            args+=("$arg")
        done

        command adb.exe "${args[@]}"
    }

    adb()     { _adb_win "$@" }
    adb.exe() { _adb_win "$@" }
fi

# ==================================================
# 9. Fastfetch (una sola vez, tras el primer prompt)
# ==================================================
if (( $+commands[fastfetch] )); then
    autoload -Uz add-zsh-hook

    function _run_fastfetch_once() {
        fastfetch
        add-zsh-hook -d precmd _run_fastfetch_once
        unfunction _run_fastfetch_once
    }
    add-zsh-hook precmd _run_fastfetch_once
fi

# ==================================================
# 10. Powerlevel10k (al final)
# ==================================================
[[ -f ~/.p10k.zsh ]] && source ~/.p10k.zsh
